# Settings are read once at start-up; a missing or malformed one stops the
# CMS (blog/config.py). CMS_ENV picks the defaults: local (this computer) or
# cloud. Any setting below overrides its default.
CMS_ENV=local

# --- Local (CMS_ENV=local): these defaults need no changes ---
# DATABASE_URL=postgresql+psycopg://blog:blog@127.0.0.1:5432/blog
# ALLOWED_HOSTS=127.0.0.1,localhost
# COOKIE_SECURE=0
# ENABLE_DOCS=1

# --- Cloud (CMS_ENV=cloud): the first three are required ---
# Guides: docs/cloud-ec2.md (Cloudflare) or docs/cloud-tailscale.md.
# DATABASE_URL=postgresql+psycopg://<user>:<password>@127.0.0.1:5432/<db>
# For RDS, add ?sslmode=verify-full&sslrootcert=/run/secrets/rds-global-bundle.pem (docs/cms-deployment.md).
# ALLOWED_HOSTS=cms.<your domain>          # or <host>.<tailnet>.ts.net
# CMS_ORIGIN=https://cms.<your domain>     # or https://<host>.<tailnet>.ts.net
# COOKIE_SECURE and ENABLE_DOCS default to 1 and 0 there.
# A cloud container has no content repo clone, so it publishes through the
# API (CONTENT_REPO below).

# --- Cloudflare Access (only for a CMS behind Cloudflare Access) ---
# Set all three or none. Once set, password sign-in is off and every request
# needs a valid Access token for one of these emails (docs/cloud-ec2.md).
# CLOUDFLARE_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
# CLOUDFLARE_ACCESS_AUD=<64-character Application Audience (AUD) tag>
# CLOUDFLARE_ACCESS_EMAILS=you@example.com

# --- 更新網站 (both) ---
# Your fork of this repo, whose deploy.yml 更新網站 starts.
DEPLOY_REPO=YOUR_USERNAME/personal-blog
# API publishing, recommended for new local and cloud installations: the CMS
# writes to the content repo through the GitHub API and needs no clone.
# CONTENT_REPO=YOUR_USERNAME/personal-blog-content
# CONTENT_BRANCH=main
# CONTENT_TRANSPORT=auto  # auto, api or git; auto selects api when CONTENT_REPO is set
# Git publishing, the older option: a local clone of your content repo, pushed
# with this computer's git credentials. Used when CONTENT_REPO is not set.
# CONTENT_REPO_DIR=/path/to/personal-blog-content
# Fine-grained token with Actions read/write on DEPLOY_REPO (docs/fork-and-deploy.md
# step 4). With API publishing it also needs Contents read/write on the content
# repo. Leave it empty when using the GitHub App below.
# Older .env files call it GITHUB_TOKEN, which still works.
CMS_GITHUB_TOKEN=

# --- Release notice (scripts/start.sh) ---
# Repo whose newer releases start.sh announces; off turns the check off.
# UPDATE_CHECK_REPO=Hack-Ray/personal-blog

# --- Backups (scripts/backup.sh) ---
# A folder (default backups/) or s3://bucket/prefix, which needs the aws CLI.
# BACKUP_TARGET=backups
# Keep only the newest N backups in a folder target (unset keeps all).
# BACKUP_KEEP=30
# While the CMS runs, back up again every N hours (local default 24, cloud
# default 0 = off, since the host schedules backups there).
# BACKUP_EVERY_HOURS=24

# --- Optional GitHub App authentication (instead of a personal token) ---
# Install the App only on the repositories it needs. Grant Contents read/write
# on content and Actions read/write on the deployment repo. Disable webhooks.
# GITHUB_AUTH=app  # auto (default), app, token
# GITHUB_APP_ID=123456
# GITHUB_APP_INSTALLATION_ID=12345678
# GITHUB_APP_PRIVATE_KEY_FILE=/absolute/path/to/github-app.pem
# Mount the PEM read-only when using containers; never put it in the image or git.
# The backend obtains short-lived installation tokens and renews them before expiry.
# Explicit GITHUB_AUTH=token keeps using CMS_GITHUB_TOKEN if App settings remain present.

# --- Optional GitHub endpoint/timeouts (same in local/cloud) ---
# GITHUB_API_URL=https://api.github.com
# GITHUB_TIMEOUT=30
# DEPLOY_WORKFLOW=deploy.yml
# DEPLOY_REF=main

# --- 流量數據 (optional) ---
# Off unless both settings of a pair are set; without them the CMS never
# calls Cloudflare or Google. Steps: docs/analytics.md.
# Cloudflare: a token with only Zone → Analytics → Read on this one zone.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=<zone id>
# Google Search Console: the property exactly as Search Console shows it,
# sc-domain:example.com or https://example.com/, and a service account JSON
# key kept outside the repo or in backend/secrets/ (git-ignored).
# GSC_SITE_URL=sc-domain:example.com
# GSC_CREDENTIALS_FILE=/absolute/path/to/backend/secrets/search-console.json

# --- 流量數據: cloud host (optional, AWS only; docs/analytics.md) ---
# The EC2 host's CPU, network and status checks; set both or neither.
# The instance role needs cloudwatch:GetMetricStatistics (infra/aws/cms-ec2.yaml).
# AWS_INSTANCE_ID=i-0123456789abcdef0
# AWS_REGION=ap-northeast-1
# The backup bucket's name only (no s3:// or prefix); needs the two above.
# BACKUP_BUCKET=<bucket name>
