DATABASE_URL=postgresql+psycopg://blog:blog@127.0.0.1:5432/blog
# Local clone of personal-blog-content, used by "更新網站" in the CMS.
CONTENT_REPO_DIR=/path/to/personal-blog-content
# Fine-grained token: personal-blog Actions read/write (docs/setup-todo.md B4).
GITHUB_TOKEN=
# Set to 1 once the CMS is served over HTTPS.
COOKIE_SECURE=
