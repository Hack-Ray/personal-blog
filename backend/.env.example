# Settings are read once at start-up; a missing or malformed one stops the
# CMS (blog/config.py). CMS_ENV picks the defaults: local (this computer) or
# cloud. Any setting below overrides its default.
CMS_ENV=local

# --- Local (CMS_ENV=local): these defaults need no changes ---
# DATABASE_URL=postgresql+psycopg://blog:blog@127.0.0.1:5432/blog
# ALLOWED_HOSTS=127.0.0.1,localhost
# COOKIE_SECURE=0
# ENABLE_DOCS=1

# --- Cloud (CMS_ENV=cloud): the first three are required ---
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<db>?sslmode=verify-full
# ALLOWED_HOSTS=cms.<tailnet>.ts.net
# CMS_ORIGIN=https://cms.<tailnet>.ts.net
# COOKIE_SECURE and ENABLE_DOCS default to 1 and 0 there.

# --- 更新網站 (both) ---
# Local clone of your content repo.
CONTENT_REPO_DIR=/path/to/personal-blog-content
# Your fork of this repo, whose deploy.yml 更新網站 starts.
DEPLOY_REPO=YOUR_USERNAME/personal-blog
# Fine-grained token with Actions read/write on that repo only (docs/fork-and-deploy.md step 4).
# Older .env files call it GITHUB_TOKEN, which still works.
CMS_GITHUB_TOKEN=
