{
  "name": "personal-blog-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-snapshot-images.ts && next dev",
    "build": "node scripts/copy-snapshot-images.ts && next build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "check-links": "node scripts/check-links.ts"
  },
  "dependencies": {
    "marked": "18.1.1",
    "next": "16.4.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "shiki": "4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "sharp": "0.35.5",
    "typescript": "5.9.3"
  }
}
