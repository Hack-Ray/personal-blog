{
  "name": "personal-blog-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-snapshot-images.ts && node scripts/render-diagrams.ts && next dev",
    "build": "node scripts/copy-snapshot-images.ts && node scripts/render-diagrams.ts && next build && node scripts/create-cdn-config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "check-links": "node scripts/check-links.ts",
    "icons": "node scripts/make-icons.ts"
  },
  "dependencies": {
    "marked": "18.1.1",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "mermaid": "12.2.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2"
  }
}
